{
  "manifest_version": 3,
  "name": "mast",
  "version": "1.4",
  "description": "Meeting AI Summarizer & Transcriber for MS Teams.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://*.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
