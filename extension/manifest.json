{
  "manifest_version": 3,
  "name": "mast",
  "version": "2.0",
  "description": "Meeting AI Summarizer & Transcriber for MS Teams.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html"
  }
}
